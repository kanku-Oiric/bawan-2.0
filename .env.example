# Salin file ini jadi .env lalu isi nilainya. Jangan commit .env.
DISCORD_TOKEN=
SUPABASE_URL=
# Key service_role / secret (sb_secret_...), BUKAN anon/publishable.
SUPABASE_KEY=

# Stage 1 pepper untuk algo v1 (hex, minimal 32 byte). Buat sendiri:
#   python -c "import secrets; print(secrets.token_hex(32))"
# RAHASIA sampai reveal di akhir eksperimen. Setelah bot pertama kali jalan,
# commitment-nya terkunci — mengganti nilai ini membuat bot menolak start.
WORLD_SEED_PEPPER=

# Saksi eksternal: URL webhook Discord di channel PUBLIK.
# Kosong = event tetap dicatat dan dikirim begitu diisi.
WORLD_LOG_WEBHOOK=

# Project Supabase KHUSUS TES (untuk --live / --live-db / --security).
# Wajib project yang berbeda dari SUPABASE_URL.
SUPABASE_TEST_URL=
SUPABASE_TEST_KEY=
# Opsional: anon/publishable key project TES, untuk uji bahwa anon ditolak.
SUPABASE_TEST_ANON_KEY=
